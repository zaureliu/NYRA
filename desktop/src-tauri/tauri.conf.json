{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kazumi",
  "version": "0.6.0",
  "identifier": "local.nyra.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm.cmd --prefix ../frontend run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Kazumi", "url": "desktop.html", "width": 480, "height": 560, "minWidth": 240, "minHeight": 280, "transparent": true, "decorations": false, "alwaysOnTop": true, "skipTaskbar": true, "shadow": false, "resizable": false, "visible": true }],
    "security": { "csp": "default-src 'self' asset: http://asset.localhost; connect-src 'self' http://127.0.0.1:8000 ws://127.0.0.1:8000; media-src 'self' http://127.0.0.1:8000 blob:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": { "../../packaging/dist/kazumi-backend/": "backend-runtime/" },
    "windows": { "nsis": { "installMode": "perMachine" } }
  }
}
