# Core
NYRA_ENV=development
NYRA_HOST=127.0.0.1
NYRA_BACKEND_PORT=8000
NYRA_FRONTEND_PORT=5173
NYRA_LOG_LEVEL=INFO
NYRA_DATABASE_PATH=data/nyra.db

# LLM (local by default)
NYRA_LLM_PROVIDER=ollama
NYRA_LLM_MODEL=qwen3:8b
NYRA_OLLAMA_URL=http://127.0.0.1:11434
NYRA_LLM_TIMEOUT_SECONDS=180
NYRA_OLLAMA_PRELOAD=true
NYRA_OLLAMA_KEEP_ALIVE=1h
NYRA_OLLAMA_WARMUP=true
NYRA_OLLAMA_CONTEXT_SIZE=8192
NYRA_OLLAMA_PRELOAD_TIMEOUT_SECONDS=300
NYRA_OLLAMA_RECOVERY_INTERVAL_SECONDS=10
NYRA_OLLAMA_UNLOAD_PREVIOUS_MODEL=true

# Speech
NYRA_STT_PROVIDER=faster_whisper
NYRA_STT_MODEL=tiny
NYRA_STT_DEVICE=cpu
NYRA_STT_COMPUTE_TYPE=int8
NYRA_STT_LANGUAGE=pt
NYRA_STT_BEAM_SIZE=1
NYRA_STT_CPU_THREADS=4
NYRA_STT_WORKERS=1
NYRA_SILENCE_THRESHOLD=0.018
NYRA_TTS_PROVIDER=kokoro
NYRA_TTS_LANGUAGE=pt-BR
NYRA_TTS_MODEL_PATH=data/models/kokoro-v1.0.int8.onnx
NYRA_TTS_VOICES_PATH=data/models/voices-v1.0.bin
NYRA_TTS_VOICE=pf_dora
NYRA_TTS_SPEAKING_RATE=0.97
NYRA_TTS_FALLBACK_PROVIDER=pyttsx3
NYRA_CHATTERBOX_PYTHON=.venv-chatterbox/Scripts/python.exe
NYRA_CHATTERBOX_DEVICE=cpu
NYRA_CHATTERBOX_REFERENCE=data/voices/nyra_reference.wav
NYRA_MICROPHONE=default
NYRA_SPEAKER=default
NYRA_AUDIO_VOLUME=0.9
NYRA_MIC_GAIN=1.0
NYRA_MIC_PREROLL_MS=250
NYRA_MIC_POSTROLL_MS=850
NYRA_VOICE_SPEECH_START_MS=100
NYRA_VOICE_MAX_UTTERANCE_SECONDS=60
NYRA_VAD_ENABLED=true
NYRA_VAD_THRESHOLD=0.50
NYRA_VAD_MIN_SPEECH_MS=250
NYRA_VAD_MIN_SILENCE_MS=650
NYRA_VAD_SPEECH_PAD_MS=250
NYRA_KEEP_DEBUG_AUDIO=false
MAX_VOICE_HUNTER_DOWNLOAD_GB=8
# Optional isolated experimental provider; never loaded during normal NYRA startup.
NYRA_OMNIVOICE_PYTHON=.venv-omnivoice/Scripts/python.exe
NYRA_OMNIVOICE_MODEL=edwixx/omnivoice-brpt-v15

# Always Listening (explicit opt-in; audio and wake-word processing stay local)
NYRA_ALWAYS_LISTENING_ENABLED=false
NYRA_LISTENING_MODE=wake_word
NYRA_WAKE_WORD=Nyra
NYRA_HANDS_FREE_TIMEOUT_SECONDS=120
NYRA_LISTENING_GUARD_MS=400
NYRA_LISTENING_PRIVACY_INDICATOR=true
NYRA_LISTENING_AUDIO_DEBUG=false
NYRA_CONVERSATION_ENGINE=true
NYRA_VOICE_BARGE_IN=true
NYRA_VOICE_STREAM_TTS=true

# Network Watch (read-only and opt-in)
NYRA_NETWORK_WATCH_ENABLED=false
NYRA_NETWORK_VOICE_ALERTS=true
NYRA_NETWORK_DESKTOP_ALERTS=true
NYRA_NETWORK_QUIET_MODE=false
NYRA_NETWORK_CRITICAL_VOICE_IN_QUIET=false
NYRA_NETWORK_INTERFACE_INTERVAL=1
NYRA_NETWORK_GATEWAY_INTERVAL=2
NYRA_NETWORK_INTERNET_INTERVAL=5
NYRA_NETWORK_DNS_INTERVAL=15
NYRA_NETWORK_HTTP_INTERVAL=30
NYRA_NETWORK_LATENCY_WARNING_MS=100
NYRA_NETWORK_LATENCY_CRITICAL_MS=200
NYRA_NETWORK_PACKET_LOSS_WARNING=5
NYRA_NETWORK_PACKET_LOSS_CRITICAL=15
NYRA_NETWORK_JITTER_WARNING_MS=40
NYRA_NETWORK_ALERT_COOLDOWN_SECONDS=300
NYRA_NETWORK_HISTORY_RETENTION_DAYS=30
NYRA_NETWORK_DNS_TARGET=cloudflare.com
NYRA_NETWORK_INTERNET_TARGETS=1.1.1.1:443,8.8.8.8:53

# Local System Shell (PowerShell/CMD, risk-classified and audited)
NYRA_SHELL_ENABLED=true
NYRA_SHELL_DEFAULT=powershell
NYRA_SHELL_TIMEOUT_SECONDS=30
NYRA_SHELL_MAX_TIMEOUT_SECONDS=300
NYRA_SHELL_MAX_OUTPUT_CHARS=50000
NYRA_SHELL_MAX_CALLS_PER_TURN=10
NYRA_SHELL_CONFIRM_DESTRUCTIVE=true
NYRA_SHELL_APPROVAL_TTL_SECONDS=300
NYRA_SHELL_DEFAULT_WORKING_DIRECTORY=.

# Trusted SSH (registered hosts only; keys and known_hosts never reach the LLM)
NYRA_REMOTE_SHELL_ENABLED=true
NYRA_SSH_CONNECT_TIMEOUT_SECONDS=5
NYRA_SSH_COMMAND_TIMEOUT_SECONDS=30
NYRA_SSH_MAX_TIMEOUT_SECONDS=300
NYRA_SSH_MAX_OUTPUT_CHARS=50000
NYRA_TRUSTED_HOSTS_PATH=config/network_aliases.json

# Bounded autonomous Agent Loop
NYRA_AGENT_ENABLED=true
NYRA_AGENT_MAX_STEPS=12
NYRA_AGENT_MAX_TOOL_CALLS=20
NYRA_AGENT_MAX_RUNTIME_SECONDS=300
NYRA_AGENT_READ_ONLY=false
NYRA_AGENT_AUTO_REMEDIATION=true
# Comma-separated normalized action IDs. Empty is fail-closed.
NYRA_AGENT_AUTO_REMEDIATION_ACTIONS=
NYRA_AGENT_MAX_IDENTICAL_REPEATS=2
NYRA_AGENT_MAX_CONSECUTIVE_FAILURES=3

# Utamo Sentinel Bridge (opt-in, local/LAN, authenticated and read-only)
NYRA_SENTINEL_WATCH_ENABLED=false
NYRA_SENTINEL_AUTO_DISCOVERY=true
NYRA_SENTINEL_DISCOVERY_INTERVAL=60
NYRA_SENTINEL_HOST=
NYRA_SENTINEL_PORT=5000
NYRA_SENTINEL_PREFER_MANUAL_HOST=true
NYRA_SENTINEL_BRIDGE_TOKEN=
NYRA_SENTINEL_VOICE_ALERTS=true
NYRA_SENTINEL_DESKTOP_ALERTS=true
NYRA_SENTINEL_CRITICAL_ONLY=false
NYRA_SENTINEL_STORE_EVENT_HISTORY=true
NYRA_SENTINEL_CREATE_EPISODIC_MEMORY=false
NYRA_SENTINEL_AUTO_RECONNECT=true
NYRA_SENTINEL_RECONNECT_BACKOFF=1,2,5,10,30,60
NYRA_SENTINEL_DEBUG_MODE=false
# Optional private IPv4 ranges only, up to /24, comma-separated.
NYRA_SENTINEL_DISCOVERY_ALLOWLIST=
NYRA_SENTINEL_EVENT_RETENTION_DAYS=30
NYRA_SENTINEL_ALERT_COOLDOWN_SECONDS=300
NYRA_SENTINEL_DISCONNECT_GRACE_SECONDS=7

# Desktop Presence (startup remains opt-in)
NYRA_DESKTOP_ALWAYS_ON_TOP=true
NYRA_DESKTOP_CLICK_THROUGH=false
NYRA_DESKTOP_OVERLAY_SCALE=1.0
NYRA_DESKTOP_SPEECH_BUBBLE=true
NYRA_DESKTOP_IDLE_ANIMATION=true
NYRA_DESKTOP_START_WITH_WINDOWS=false
# Tauri: exibição automática do Desktop Presence no start (lido pelo processo desktop)
NYRA_DESKTOP_PRESENCE_SHOW_ON_START=true

# Turn Isolation (identidade imutável por turno; cada input é um novo turn_id)
NYRA_TURN_ISOLATION_ENABLED=true
# Um turno ativo por conversa: novo input cancela o anterior com cleanup garantido
NYRA_CONVERSATION_SINGLE_ACTIVE_TURN=true

# Desktop Application Control
# Descoberta dinâmica de apps instalados (App Paths, PATH, Start Menu, Get-StartApps/UWP)
NYRA_DESKTOP_DYNAMIC_APP_DISCOVERY=true

# Elevated Operations Broker (UAC consent legítimo; sem bypass e sem armazenar senha)
NYRA_ELEVATED_BROKER_ENABLED=true

# Homelab
NYRA_HOMELAB_POLL_INTERVAL=60
NYRA_PROACTIVE_MODE=false
NYRA_CPU_ALERT_THRESHOLD=90
NYRA_MEMORY_ALERT_THRESHOLD=90
NYRA_EVENT_COOLDOWN_SECONDS=900

# Homelab Control Plane (registry unificado + probes + integrações nativas)
NYRA_HOMELAB_ENABLED=true
# Registry de hosts (fonte única; sem credenciais dentro do arquivo)
NYRA_HOMELAB_REGISTRY_PATH=config/homelab_hosts.yaml
NYRA_HOMELAB_DEFAULT_TIMEOUT_SECONDS=5
NYRA_HOMELAB_OVERVIEW_CACHE_SECONDS=5
NYRA_HOMELAB_OFFLINE_FAILURE_THRESHOLD=2

# Optional Proxmox (API Token dedicado recomendado; veja docs/integrations/proxmox.md)
NYRA_PROXMOX_ENABLED=true
NYRA_PROXMOX_URL=
NYRA_PROXMOX_TOKEN_ID=
NYRA_PROXMOX_TOKEN_SECRET=
NYRA_PROXMOX_VERIFY_SSL=true
# Pin SHA-256 do certificado leaf (opcional; hex sem separadores)
NYRA_PROXMOX_TLS_FINGERPRINT=

# Optional OpenWrt (not active in MVP)
NYRA_OPENWRT_URL=
NYRA_OPENWRT_USERNAME=
NYRA_OPENWRT_PASSWORD=

# Home Assistant REST API (Long-Lived Access Token da NYRA; URL exatamente como fornecida,
# sem adicionar porta. Veja docs/integrations/home-assistant.md)
NYRA_HOME_ASSISTANT_ENABLED=true
NYRA_HOME_ASSISTANT_URL=
NYRA_HOME_ASSISTANT_TOKEN=

# ---- Operator V2 (prompt9) — toda flag tem consumer + teste (sem dead settings)
# Parte A: Screen Understanding (captura escopada, frames com TTL, OCR só fallback)
NYRA_VISION_ENABLED=true
NYRA_VISION_FRAME_TTL_SECONDS=45
NYRA_VISION_DEBUG_KEEP_FRAMES=false
# Parte C: Browser Control via CDP (navegador gerenciado da NYRA)
NYRA_BROWSER_CONTROL_ENABLED=true
# Parte D: Credential Broker (Windows Credential Manager/DPAPI; LLM nunca vê segredo)
NYRA_CREDENTIAL_BROKER_ENABLED=true
# Parte F: Persistent Jobs
NYRA_PERSISTENT_JOBS_ENABLED=true
# Parte J: Workflow Memory
NYRA_WORKFLOW_ENGINE_ENABLED=true
# Parte I: Event-driven Desktop Watcher
NYRA_DESKTOP_WATCHER_ENABLED=true
NYRA_WATCH_DEFAULT_TTL_SECONDS=300
# Parte L: External Watchdog (heartbeat lido pelo backend)
NYRA_WATCHDOG_ENABLED=true
# Parte M: Proactive Operator (default OFF; regras cadastradas apenas)
NYRA_PROACTIVE_OPERATOR_ENABLED=false
# Parte E: Elevated session TTL padrão (UAC legítimo único por sessão)
NYRA_ELEVATED_SESSION_DEFAULT_TTL_SECONDS=300
