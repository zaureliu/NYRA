# Core
KAZUMI_ENV=development
KAZUMI_HOST=127.0.0.1
KAZUMI_BACKEND_PORT=8000
KAZUMI_FRONTEND_PORT=5173
KAZUMI_LOG_LEVEL=INFO
KAZUMI_DATABASE_PATH=data/kazumi.db

# LLM (local by default)
KAZUMI_LLM_PROVIDER=ollama
KAZUMI_LLM_MODEL=qwen3:8b
KAZUMI_OLLAMA_URL=http://127.0.0.1:11434
KAZUMI_LLM_TIMEOUT_SECONDS=180
KAZUMI_OLLAMA_PRELOAD=true
KAZUMI_OLLAMA_KEEP_ALIVE=1h
KAZUMI_OLLAMA_WARMUP=true
KAZUMI_OLLAMA_CONTEXT_SIZE=8192
KAZUMI_OLLAMA_PRELOAD_TIMEOUT_SECONDS=300
KAZUMI_OLLAMA_RECOVERY_INTERVAL_SECONDS=10
KAZUMI_OLLAMA_UNLOAD_PREVIOUS_MODEL=true

# Speech
KAZUMI_STT_PROVIDER=faster_whisper
KAZUMI_STT_MODEL=tiny
KAZUMI_STT_DEVICE=cpu
KAZUMI_STT_COMPUTE_TYPE=int8
KAZUMI_STT_LANGUAGE=pt
KAZUMI_STT_BEAM_SIZE=1
KAZUMI_STT_CPU_THREADS=4
KAZUMI_STT_WORKERS=1
KAZUMI_SILENCE_THRESHOLD=0.018
KAZUMI_TTS_PROVIDER=kokoro
KAZUMI_TTS_LANGUAGE=pt-BR
KAZUMI_TTS_MODEL_PATH=data/models/kokoro-v1.0.int8.onnx
KAZUMI_TTS_VOICES_PATH=data/models/voices-v1.0.bin
KAZUMI_TTS_VOICE=pf_dora
KAZUMI_TTS_SPEAKING_RATE=0.97
KAZUMI_TTS_FALLBACK_PROVIDER=pyttsx3
KAZUMI_CHATTERBOX_PYTHON=.venv-chatterbox/Scripts/python.exe
KAZUMI_CHATTERBOX_DEVICE=cpu
KAZUMI_CHATTERBOX_REFERENCE=data/voices/kazumi_reference.wav
KAZUMI_MICROPHONE=default
KAZUMI_SPEAKER=default
KAZUMI_AUDIO_VOLUME=0.9
KAZUMI_MIC_GAIN=1.0
KAZUMI_MIC_PREROLL_MS=250
KAZUMI_MIC_POSTROLL_MS=850
KAZUMI_VOICE_SPEECH_START_MS=100
KAZUMI_VOICE_MAX_UTTERANCE_SECONDS=60
KAZUMI_VAD_ENABLED=true
KAZUMI_VAD_THRESHOLD=0.50
KAZUMI_VAD_MIN_SPEECH_MS=250
KAZUMI_VAD_MIN_SILENCE_MS=650
KAZUMI_VAD_SPEECH_PAD_MS=250
KAZUMI_KEEP_DEBUG_AUDIO=false
MAX_VOICE_HUNTER_DOWNLOAD_GB=8
# Optional isolated experimental provider; never loaded during normal KAZUMI startup.
KAZUMI_OMNIVOICE_PYTHON=.venv-omnivoice/Scripts/python.exe
KAZUMI_OMNIVOICE_MODEL=edwixx/omnivoice-brpt-v15

# Always Listening (explicit opt-in; audio and wake-word processing stay local)
KAZUMI_ALWAYS_LISTENING_ENABLED=false
KAZUMI_LISTENING_MODE=wake_word
KAZUMI_WAKE_WORD=kazumi
KAZUMI_HANDS_FREE_TIMEOUT_SECONDS=120
KAZUMI_LISTENING_GUARD_MS=400
KAZUMI_LISTENING_PRIVACY_INDICATOR=true
KAZUMI_LISTENING_AUDIO_DEBUG=false
KAZUMI_CONVERSATION_ENGINE=true
KAZUMI_VOICE_BARGE_IN=true
KAZUMI_VOICE_STREAM_TTS=true

# Network Watch (read-only and opt-in)
KAZUMI_NETWORK_WATCH_ENABLED=false
KAZUMI_NETWORK_VOICE_ALERTS=true
KAZUMI_NETWORK_DESKTOP_ALERTS=true
KAZUMI_NETWORK_QUIET_MODE=false
KAZUMI_NETWORK_CRITICAL_VOICE_IN_QUIET=false
KAZUMI_NETWORK_INTERFACE_INTERVAL=1
KAZUMI_NETWORK_GATEWAY_INTERVAL=2
KAZUMI_NETWORK_INTERNET_INTERVAL=5
KAZUMI_NETWORK_DNS_INTERVAL=15
KAZUMI_NETWORK_HTTP_INTERVAL=30
KAZUMI_NETWORK_LATENCY_WARNING_MS=100
KAZUMI_NETWORK_LATENCY_CRITICAL_MS=200
KAZUMI_NETWORK_PACKET_LOSS_WARNING=5
KAZUMI_NETWORK_PACKET_LOSS_CRITICAL=15
KAZUMI_NETWORK_JITTER_WARNING_MS=40
KAZUMI_NETWORK_ALERT_COOLDOWN_SECONDS=300
KAZUMI_NETWORK_HISTORY_RETENTION_DAYS=30
KAZUMI_NETWORK_DNS_TARGET=cloudflare.com
KAZUMI_NETWORK_INTERNET_TARGETS=1.1.1.1:443,8.8.8.8:53

# Local System Shell (PowerShell/CMD, risk-classified and audited)
KAZUMI_SHELL_ENABLED=true
KAZUMI_SHELL_DEFAULT=powershell
KAZUMI_SHELL_TIMEOUT_SECONDS=30
KAZUMI_SHELL_MAX_TIMEOUT_SECONDS=300
KAZUMI_SHELL_MAX_OUTPUT_CHARS=50000
KAZUMI_SHELL_MAX_CALLS_PER_TURN=10
KAZUMI_SHELL_CONFIRM_DESTRUCTIVE=true
KAZUMI_SHELL_APPROVAL_TTL_SECONDS=300
KAZUMI_SHELL_DEFAULT_WORKING_DIRECTORY=.

# Trusted SSH (registered hosts only; keys and known_hosts never reach the LLM)
KAZUMI_REMOTE_SHELL_ENABLED=true
KAZUMI_SSH_CONNECT_TIMEOUT_SECONDS=5
KAZUMI_SSH_COMMAND_TIMEOUT_SECONDS=30
KAZUMI_SSH_MAX_TIMEOUT_SECONDS=300
KAZUMI_SSH_MAX_OUTPUT_CHARS=50000
KAZUMI_TRUSTED_HOSTS_PATH=config/network_aliases.local.json

# Bounded autonomous Agent Loop
KAZUMI_AGENT_ENABLED=true
KAZUMI_AGENT_MAX_STEPS=12
KAZUMI_AGENT_MAX_TOOL_CALLS=20
KAZUMI_AGENT_MAX_RUNTIME_SECONDS=300
KAZUMI_AGENT_READ_ONLY=false
KAZUMI_AGENT_AUTO_REMEDIATION=true
# Comma-separated normalized action IDs. Empty is fail-closed.
KAZUMI_AGENT_AUTO_REMEDIATION_ACTIONS=
KAZUMI_AGENT_MAX_IDENTICAL_REPEATS=2
KAZUMI_AGENT_MAX_CONSECUTIVE_FAILURES=3

# Utamo Sentinel Bridge (opt-in, local/LAN, authenticated and read-only)
KAZUMI_SENTINEL_WATCH_ENABLED=false
KAZUMI_SENTINEL_AUTO_DISCOVERY=true
KAZUMI_SENTINEL_DISCOVERY_INTERVAL=60
KAZUMI_SENTINEL_HOST=
KAZUMI_SENTINEL_PORT=5000
KAZUMI_SENTINEL_PREFER_MANUAL_HOST=true
KAZUMI_SENTINEL_BRIDGE_TOKEN=
KAZUMI_SENTINEL_VOICE_ALERTS=true
KAZUMI_SENTINEL_DESKTOP_ALERTS=true
KAZUMI_SENTINEL_CRITICAL_ONLY=false
KAZUMI_SENTINEL_STORE_EVENT_HISTORY=true
KAZUMI_SENTINEL_CREATE_EPISODIC_MEMORY=false
KAZUMI_SENTINEL_AUTO_RECONNECT=true
KAZUMI_SENTINEL_RECONNECT_BACKOFF=1,2,5,10,30,60
KAZUMI_SENTINEL_DEBUG_MODE=false
# Optional private IPv4 ranges only, up to /24, comma-separated.
KAZUMI_SENTINEL_DISCOVERY_ALLOWLIST=
KAZUMI_SENTINEL_EVENT_RETENTION_DAYS=30
KAZUMI_SENTINEL_ALERT_COOLDOWN_SECONDS=300
KAZUMI_SENTINEL_DISCONNECT_GRACE_SECONDS=7

# Desktop Presence (startup remains opt-in)
KAZUMI_DESKTOP_ALWAYS_ON_TOP=true
KAZUMI_DESKTOP_CLICK_THROUGH=false
KAZUMI_DESKTOP_OVERLAY_SCALE=1.0
KAZUMI_DESKTOP_SPEECH_BUBBLE=true
KAZUMI_DESKTOP_IDLE_ANIMATION=true
KAZUMI_DESKTOP_START_WITH_WINDOWS=false
# Tauri: exibição automática do Desktop Presence no start (lido pelo processo desktop)
KAZUMI_DESKTOP_PRESENCE_SHOW_ON_START=true

# Turn Isolation (identidade imutável por turno; cada input é um novo turn_id)
KAZUMI_TURN_ISOLATION_ENABLED=true
# Um turno ativo por conversa: novo input cancela o anterior com cleanup garantido
KAZUMI_CONVERSATION_SINGLE_ACTIVE_TURN=true

# Desktop Application Control
# Descoberta dinâmica de apps instalados (App Paths, PATH, Start Menu, Get-StartApps/UWP)
KAZUMI_DESKTOP_DYNAMIC_APP_DISCOVERY=true

# Elevated Operations Broker (UAC consent legítimo; sem bypass e sem armazenar senha)
KAZUMI_ELEVATED_BROKER_ENABLED=true

# Homelab
KAZUMI_HOMELAB_POLL_INTERVAL=60
KAZUMI_PROACTIVE_MODE=false
KAZUMI_CPU_ALERT_THRESHOLD=90
KAZUMI_MEMORY_ALERT_THRESHOLD=90
KAZUMI_EVENT_COOLDOWN_SECONDS=900

# Homelab Control Plane (registry unificado + probes + integrações nativas)
KAZUMI_HOMELAB_ENABLED=true
KAZUMI_HOMELAB_MUTATIONS_ENABLED=false
# Registry de hosts (fonte única; sem credenciais dentro do arquivo)
KAZUMI_HOMELAB_REGISTRY_PATH=config/homelab_hosts.local.yaml
KAZUMI_HOMELAB_DEFAULT_TIMEOUT_SECONDS=5
KAZUMI_HOMELAB_OVERVIEW_CACHE_SECONDS=5
KAZUMI_HOMELAB_OFFLINE_FAILURE_THRESHOLD=2

# Optional Proxmox (API Token dedicado recomendado; veja docs/integrations/proxmox.md)
KAZUMI_PROXMOX_ENABLED=true
KAZUMI_PROXMOX_URL=
KAZUMI_PROXMOX_TOKEN_ID=
KAZUMI_PROXMOX_TOKEN_SECRET=
KAZUMI_PROXMOX_VERIFY_SSL=true
# Pin SHA-256 do certificado leaf (opcional; hex sem separadores)
KAZUMI_PROXMOX_TLS_FINGERPRINT=

# Optional OpenWrt (not active in MVP)
KAZUMI_OPENWRT_URL=
KAZUMI_OPENWRT_USERNAME=
KAZUMI_OPENWRT_PASSWORD=

# Home Assistant REST API (Long-Lived Access Token da KAZUMI; URL exatamente como fornecida,
# sem adicionar porta. Veja docs/integrations/home-assistant.md)
KAZUMI_HOME_ASSISTANT_ENABLED=true
KAZUMI_HOME_ASSISTANT_URL=
KAZUMI_HOME_ASSISTANT_TOKEN=

# ---- Operator V2 (prompt9) — toda flag tem consumer + teste (sem dead settings)
# Parte A: Screen Understanding (captura escopada, frames com TTL, OCR só fallback)
KAZUMI_VISION_ENABLED=true
KAZUMI_VISION_FRAME_TTL_SECONDS=45
KAZUMI_VISION_DEBUG_KEEP_FRAMES=false
# Parte C: Browser Control via CDP (navegador gerenciado da KAZUMI)
KAZUMI_BROWSER_CONTROL_ENABLED=true
# Parte D: Credential Broker (Windows Credential Manager/DPAPI; LLM nunca vê segredo)
KAZUMI_CREDENTIAL_BROKER_ENABLED=true
# Parte F: Persistent Jobs
KAZUMI_PERSISTENT_JOBS_ENABLED=true
# Parte J: Workflow Memory
KAZUMI_WORKFLOW_ENGINE_ENABLED=true
# Parte I: Event-driven Desktop Watcher
KAZUMI_DESKTOP_WATCHER_ENABLED=true
KAZUMI_WATCH_DEFAULT_TTL_SECONDS=300
# Parte L: External Watchdog (heartbeat lido pelo backend)
KAZUMI_WATCHDOG_ENABLED=true
# Parte M: Proactive Operator (default OFF; regras cadastradas apenas)
KAZUMI_PROACTIVE_OPERATOR_ENABLED=false
# Parte E: Elevated session TTL padrão (UAC legítimo único por sessão)
KAZUMI_ELEVATED_SESSION_DEFAULT_TTL_SECONDS=300
KAZUMI_SELFDEV_MODE=AUTONOMOUS_SAFE
KAZUMI_SELFDEV_MODEL=qwen3:8b
KAZUMI_SELFDEV_WORKSPACE=../Kazumi-Auto-Code
KAZUMI_SELFDEV_CANONICAL_ROOT=.
KAZUMI_SELFDEV_PUBLIC_SNAPSHOT=../KAZUMI-GitHub-Public
KAZUMI_SELFDEV_RUN_WHEN_IDLE=true
KAZUMI_SELFDEV_AUTO_PUBLISH_GITHUB=false
# Optional generated hardware workspace; empty uses <USER_HOME>/KAZUMI-Projects.
KAZUMI_PROJECTS_ROOT=
